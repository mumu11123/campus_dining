# Spring Boot 从操作系统环境变量读取这些配置。
DB_URL=jdbc:mysql://localhost:3306/campus_dining?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION=604800000
